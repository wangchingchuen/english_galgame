# 店員預設用哪個模型：ollama 或 cloud（畫面上也可以切換）
PROVIDER=ollama
# 評分 Agent 用哪個模型（只在場景結束時呼叫一次，建議用比較強的雲端模型）
EVAL_PROVIDER=cloud

# 本機 Ollama（OpenAI 相容端點）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 雲端：任何 OpenAI 相容服務，例如 GitHub Models
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=github_pat_xxx
MODEL=openai/gpt-4o-mini
