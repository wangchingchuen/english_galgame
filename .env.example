# 店員預設用哪個模型：ollama 或 cloud（畫面上也可以切換）
PROVIDER=ollama
# 評分 Agent 用哪個模型（只在場景結束時呼叫一次）。目前全部用本機；之後可改 cloud 換更準的模型
EVAL_PROVIDER=ollama

# 本機 Ollama（OpenAI 相容端點）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 雲端：任何 OpenAI 相容服務（GitHub Models 已於 2026-07-30 停止服務，不能再用）
# （選用）Groq：要用時把下面三行的 # 拿掉
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxx
# MODEL=llama-3.3-70b-versatile
# Gemini（三行換成這樣）
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=你的 Gemini API key
# MODEL=gemini-2.5-flash
